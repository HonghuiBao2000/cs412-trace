@article{GAO2025127422,
title = {Mixture of causal experts: A causal perspective to build dual-level mixture-of-experts models},
journal = {Expert Systems with Applications},
volume = {280},
pages = {127422},
year = {2025},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2025.127422},
url = {https://www.sciencedirect.com/science/article/pii/S0957417425010449},
author = {Yifei Gao and Ning Xu and Hongshuo Tian and Bolun Zheng and Jinbo Cao and An-An Liu},
keywords = {Causal expert, Mixture of experts, Vision and language},
abstract = {In both visual and language tasks, the Mixture of Experts (MoE) network becomes a widely used architecture for enhancing model abilities. The MoE architecture combines multiple expert networks to learn complex data distributions. However, current MoE architectures rely on simple feed-forward networks, lacking the deconfounding abilities to handle widespread bias in training datasets, thus affecting model generalization. In order to integrate the advantages of MoE architecture with deconfounding abilities, we propose the Mixture of Causal Experts (MoCE), a novel dual-level MoE framework from a causal perspective. At the micro level, MoCE builds the deconfounding networks with FFN(Feed Forward Network)-based MoE layers called causal experts to implement interventions based on various causal graphs, including no-confounder, back-door, and front-door experts. At the macro level, MoCE integrates all causal experts and fixes the routing weight of no-confounder expert to consolidate general deconfounding abilities and enhance the specialization of other causal experts. We evaluate our MoCE on extensive vision-language tasks, and report accuracy for visual question answering, visual entailment and reasoning, as well as F1 score for long document classification. Experimental results on VQA2.0, e-SNLI-VE, NLVR2 and ECtHR show our MoCE demonstrates superiority over many strong baselines, contributing novel causal insights to the evolution of MoE architectures.}
}

