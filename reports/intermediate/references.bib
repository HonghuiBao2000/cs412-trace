  shorttitle = {{{DYNOTEARS}}},
  author = {Pamfil, Roxana and Sriwattanaworachai, Nisara and Desai, Shaan and Pilgerstorfer, Philip and Beaumont, Paul and Georgatzis, Konstantinos and Aragam, Bryon},
  year = 2020,
