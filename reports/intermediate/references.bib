  author = {Li, Zijian and Shen, Yifan and Zheng, Kaitao and Cai, Ruichu and Song, Xiangchen and Gong, Mingming and Zhu, Zhengmao and Chen, Guangyi and Zhang, Kun},
  year = 2024,
